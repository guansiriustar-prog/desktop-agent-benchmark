<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qwenwork.wallpaper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/<user>/Library/Scripts/wallpaper_rotate.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/qwenwork_wallpaper.log</string>
  <key>StandardErrorPath</key><string>/tmp/qwenwork_wallpaper.err</string>
</dict>
</plist>
